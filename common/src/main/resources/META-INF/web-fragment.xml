<web-fragment version="5.0" xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-fragment_6_0.xsd"
              metadata-complete="true">

  <name>thunibib-common</name>

  <filter>
    <filter-name>SolrServletFilter</filter-name>
    <filter-class>de.uni_jena.thunibib.solr.SolrServletFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>SolrServletFilter</filter-name>
    <servlet-name>MCRSolrSelectProxyServlet</servlet-name>
    <!-- url-pattern>/servlets/solr</url-pattern -->
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>

  <servlet>
    <servlet-name>JobStatusServlet</servlet-name>
    <servlet-class>de.uni_jena.thunibib.impex.servlets.JobStatusServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>JobStatusServlet</servlet-name>
    <url-pattern>/servlets/JobStatusServlet</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ListVanishedLDAPUsersServlet</servlet-name>
    <servlet-class>de.uni_jena.thunibib.user.ListVanishedLDAPUsersServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>ListVanishedLDAPUsersServlet</servlet-name>
    <url-pattern>/servlets/ListVanishedLDAPUsersServlet</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ListUsersSharingIdentifiersServlet</servlet-name>
    <servlet-class>de.uni_jena.thunibib.user.ListUsersSharingIdentifiersServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>ListUsersSharingIdentifiersServlet</servlet-name>
    <url-pattern>/servlets/ListUsersSharingIdentifiersServlet</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ListUsersHavingMultipleIdentifiersServlet</servlet-name>
    <servlet-class>de.uni_jena.thunibib.user.ListUsersHavingMultipleIdentifiersServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>ListUsersHavingMultipleIdentifiersServlet</servlet-name>
    <url-pattern>/servlets/ListUsersHavingMultipleIdentifiersServlet</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>HISinOneInteractionServlet</servlet-name>
    <servlet-class>de.uni_jena.thunibib.his.servlets.HISinOneInteractionServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>HISinOneInteractionServlet</servlet-name>
    <url-pattern>/servlets/HISinOneInteractionServlet</url-pattern>
  </servlet-mapping>
</web-fragment>
